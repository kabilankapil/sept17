# ─────────────────────────────────────────────────────────────
#  Frontend environment — PHP backend
#  Copy this file to .env (for dev) or .env.production (for build)
#  and set VITE_API_BASE_URL to your PHP backend's URL.
# ─────────────────────────────────────────────────────────────

# Local development (PHP built-in server or XAMPP/WAMP/Laragon)
# VITE_API_BASE_URL=http://localhost:5173/login
VITE_API_BASE_URL=http://localhost:8080

# Production on shared hosting (e.g. BigRock, Hostinger)
# If your PHP backend lives at yourdomain.com/backend/, use:
# VITE_API_BASE_URL=https://yourdomain.com/backend

# ── REMOVED (Java / Spring backend) ──────────────────────────
# VITE_API_URL was used with the old Spring Boot backend.
# It is no longer needed; _base.js falls back to it automatically
# if VITE_API_BASE_URL is not set, so old .env files still work.
